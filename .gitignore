# OS
Thumbs.db
Desktop.ini
.DS_Store

# Third-party: OpenSSL comes from the signed release tarball (fetched and
# verified by build-deps.ps1); libssh2 and argon2 are git submodules.
thirdparty/openssl/
thirdparty/downloads/
thirdparty/build/
thirdparty/build-deps.log
build.log

# Static libraries, per-target OpenSSL headers and the build manifest
# produced by build-deps.ps1
src/lib/libssh2_*.lib
src/lib/libcrypto_*.lib
src/lib/*.pdb
src/lib/include-x64/
src/lib/include-x86/
src/lib/deps-manifest.json

# Generated by CI (or by hand for local testing); BuildInfo.h picks it up via __has_include
src/include/build_info_gen.h

# Local archives and logs
*.7z
*.tar.gz
debug.log
