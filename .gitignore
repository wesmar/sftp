# Local helper scripts and diagnostics (never committed; copies kept outside the repo)
utils/
release/
.local-tests/
github.sh
git-push.sh
release-now.sh
release-update.sh
release.txt

# Environment files and machine-specific tool paths
.env
.env.*
build.local.psd1

# Build output: bin/ holds SFTPplug.zip for local smoke tests only.
